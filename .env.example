# Copy to .env (local) and fill in. Never commit real values — .env is gitignored.
# In production (e.g. Vercel), set these in the project's Environment Variables.

# ── Database ────────────────────────────────────────────────────────────────
# Local: run `npm run db:dev` and use the postgres:// URL it prints.
# Production: a hosted PostgreSQL connection string (Neon, Supabase, Prisma Postgres…).
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Local prisma dev server accepts one connection at a time → set to 1 locally.
# Leave unset in production.
DATABASE_POOL_MAX=""

# ── Bootstrap admin (read only by `npm run db:seed`) ────────────────────────
# Creates the admin if it doesn't exist; never overwrites an existing password.
# First login forces a password change. Remove ADMIN_INITIAL_PASSWORD afterwards.
ADMIN_EMAIL="you@example.com"
ADMIN_INITIAL_PASSWORD="change-me-on-first-login"

# ── Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Keys the anonymous visitor ids and rate-limit keys. Rotating it resets unique-visitor continuity.
ANALYTICS_SECRET="replace-with-32+-random-characters"
# Vercel Cron sends this as a Bearer token to /api/cron/retention.
CRON_SECRET="replace-with-32+-random-characters"

# ── Analytics & privacy ─────────────────────────────────────────────────────
ANALYTICS_ENABLED="true"
# none | truncated (IPv4 /24, IPv6 /48) | full
ANALYTICS_IP_MODE="truncated"
ANALYTICS_RETENTION_DAYS="90"
ANALYTICS_IP_RETENTION_DAYS="30"
LOCATION_RETENTION_DAYS="30"
# Opt-in browser geolocation on /privacy. Off by default; set before building.
NEXT_PUBLIC_PRECISE_LOCATION_ENABLED="false"
# Only when NOT on Vercel: the one header your proxy sets to the client IP
# (e.g. "cf-connecting-ip"). Leave empty unless your infrastructure overwrites it.
TRUSTED_IP_HEADER=""
